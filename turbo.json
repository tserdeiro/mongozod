{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "envMode": "strict",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // Runs no script: it links each package to its dependencies, so `check-types` and `test` run in
    // parallel and still miss the cache when a dependency changes (Turborepo's "transit nodes").
    "transit": {
      "dependsOn": ["^transit"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    // Compiles a consumer of the published declarations with TypeScript 5.5 and 7, after the build.
    "check-dist-types": {
      "dependsOn": ["build"],
      "outputs": []
    },
    // Compiles the examples of the docs and the README against the published declarations, after
    // the build.
    "check-docs": {
      "dependsOn": ["build"],
      "outputs": []
    },
    // Measures the type instantiations of a typical project against its budget, after the build.
    "check-type-cost": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}
