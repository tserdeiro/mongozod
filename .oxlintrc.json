{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "unicorn", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    // Rules that need type information, through oxlint-tsgolint.
    "typeAware": true
  },
  "rules": {
    "eslint/no-array-constructor": "error",
    "eslint/no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "eslint/no-fallthrough": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": false,
        "varsIgnorePattern": "^_"
      }
    ],
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_id", "_zod"]
      }
    ],
    "typescript/ban-ts-comment": "error",
    // No type assertion (`as const` aside) and no non-null assertion: the types describe every
    // value.
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/consistent-type-definitions": ["error", "interface"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": [
      "error",
      {
        "ignoreRestArgs": true
      }
    ],
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "import/no-default-export": "error",
    "import/no-unassigned-import": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/*.d.ts"],
  "overrides": [
    {
      // The entry point is empty until the model lands (roadmap phase 2): remove this override then.
      "files": ["packages/mongozod/src/index.ts"],
      "rules": {
        "unicorn/no-empty-file": "off"
      }
    },
    {
      // Their tools read the config from the default export.
      "files": ["**/tsdown.config.ts", "**/vitest.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}
