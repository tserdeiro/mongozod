{
  "name": "mongozod",
  "version": "0.0.0",
  "description": "MongoDB with the Zod schema as the single source of truth for each document.",
  "keywords": [
    "mongodb",
    "schema",
    "typescript",
    "validation",
    "zod"
  ],
  "homepage": "https://github.com/tserdeiro/mongozod#readme",
  "bugs": "https://github.com/tserdeiro/mongozod/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tserdeiro/mongozod.git",
    "directory": "packages/mongozod"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@repo/config": "workspace:*",
    "@types/node": "22.20.5",
    "mongodb": "7.7.0",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "mongodb": "^7.0.0",
    "zod": "^4.5.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
