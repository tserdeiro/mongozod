{
  "name": "mongozod",
  "version": "0.0.0",
  "description": "MongoDB with the Zod schema as the single source of truth for each document.",
  "keywords": [
    "mongodb",
    "schema",
    "typescript",
    "validation",
    "zod"
  ],
  "homepage": "https://github.com/tserdeiro/mongozod#readme",
  "bugs": "https://github.com/tserdeiro/mongozod/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tserdeiro/mongozod.git",
    "directory": "packages/mongozod"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./codecs/bson": "./dist/codecs/bson.mjs",
    "./codecs/date": "./dist/codecs/date.mjs",
    "./mzod": "./dist/mzod.mjs",
    "./plugins/soft-delete": "./dist/plugins/soft-delete.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check-dist-types": "tsc -p test/consumer && node node_modules/typescript-5.5/bin/tsc -p test/consumer",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@repo/config": "workspace:*",
    "@types/node": "22.20.5",
    "bson": "7.3.3",
    "mongodb": "7.7.0",
    "mongodb-memory-server": "11.3.0",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "typescript-5.5": "npm:typescript@5.5.4",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "bson": "^6.10.0 || ^7.0.0",
    "mongodb": "^6.20.0 || ^7.0.0",
    "zod": "^4.5.0"
  },
  "peerDependenciesMeta": {
    "bson": {
      "optional": true
    }
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
